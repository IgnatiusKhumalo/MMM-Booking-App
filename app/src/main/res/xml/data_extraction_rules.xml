<?xml version="1.0" encoding="utf-8"?>
<!--
   Configured for this app: backs up only the theme preference
   (mmm_theme_prefs) via both Android's cloud backup and device-transfer
   mechanisms, matching backup_rules.xml above for pre-API-31 devices.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="mmm_theme_prefs.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="mmm_theme_prefs.xml" />
    </device-transfer>
</data-extraction-rules>