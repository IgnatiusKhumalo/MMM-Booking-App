<?xml version="1.0" encoding="utf-8"?>
<!--
   Configured for this app: backs up only the theme preference
   (mmm_theme_prefs, written by ThemeManager) - the only genuine
   local-only setting this app stores. All other data (bookings,
   account details) lives in Firestore and does not need device backup.
   Note: This file is ignored for devices older than API 31.
-->
<full-backup-content>
    <include domain="sharedpref" path="mmm_theme_prefs.xml" />
</full-backup-content>