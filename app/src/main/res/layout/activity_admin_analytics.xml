<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarThumbVertical="@color/color_primary"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@color/color_primary"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/color_text_on_primary"
                android:contentDescription="@string/btn_ok" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/analytics_title"
                android:textColor="@color/color_text_on_primary"
                android:textSize="@dimen/text_size_18"
                android:textStyle="bold" />

            <View android:layout_width="40dp" android:layout_height="1dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.mmm.bookingapp.utils.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_bookings_created"
                        android:textColor="@color/color_text_heading"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_14"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_today" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvBookingsToday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvBookingsTodayChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_week" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvBookingsWeek" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvBookingsWeekChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_month" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvBookingsMonth" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvBookingsMonthChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_year" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvBookingsYear" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvBookingsYearChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_border" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_today" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartBookingsToday" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartBookingsToday" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_week" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartBookingsWeek" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartBookingsWeek" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_month" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartBookingsMonth" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartBookingsMonth" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_year" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartBookingsYear" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartBookingsYear" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="14dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/section_new_registrations"
                        android:textColor="@color/color_text_heading"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_14"
                        android:layout_marginBottom="10dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_today" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvRegsToday" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvRegsTodayChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_week" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvRegsWeek" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvRegsWeekChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_month" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvRegsMonth" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvRegsMonthChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="@string/period_year" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_13" />
                        <TextView android:id="@+id/tvRegsYear" android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="0" android:textColor="@color/color_text_heading" android:textStyle="bold" android:textSize="@dimen/text_size_15" android:layout_marginEnd="10dp" />
                        <TextView android:id="@+id/tvRegsYearChange" android:layout_width="70dp" android:layout_height="wrap_content"
                            android:text="0%" android:textColor="@color/color_status_confirmed" android:textSize="@dimen/text_size_12" android:gravity="end" android:textStyle="bold" />
                    </LinearLayout>

                    <View android:layout_width="match_parent" android:layout_height="1dp"
                        android:background="@color/color_border" android:layout_marginTop="4dp" android:layout_marginBottom="12dp" />

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_today" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartRegsToday" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartRegsToday" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_week" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartRegsWeek" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartRegsWeek" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="8dp">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_month" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartRegsMonth" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartRegsMonth" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical">
                        <TextView android:layout_width="50dp" android:layout_height="wrap_content"
                            android:text="@string/period_year" android:textColor="@color/color_text_primary" android:textSize="@dimen/text_size_10" />
                        <LinearLayout android:layout_width="0dp" android:layout_height="10dp" android:layout_weight="1"
                            android:orientation="horizontal" android:background="@color/color_background"
                            android:layout_marginStart="6dp">
                            <View android:id="@+id/barChartRegsYear" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="0" android:background="@color/color_primary" />
                            <View android:id="@+id/fillerChartRegsYear" android:layout_width="0dp" android:layout_height="match_parent"
                                android:layout_weight="1" android:background="@android:color/transparent" />
                        </LinearLayout>
                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/color_highlight"
                    android:padding="14dp"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/trend_section_title"
                        android:textColor="@color/color_text_heading"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_size_13"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvTrendProjection"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/color_text_heading"
                        android:textSize="@dimen/text_size_12" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/analytics_percent_caveat"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_size_11"
                    android:gravity="center" />

            </com.mmm.bookingapp.utils.MaxWidthLinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>