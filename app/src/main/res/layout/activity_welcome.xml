<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <com.mmm.bookingapp.utils.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="@dimen/screen_horizontal_padding">

        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="fitCenter"
            android:src="@drawable/mmm_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_heading"
            android:textSize="@dimen/text_size_26"
            android:textStyle="bold"
            android:textColor="@color/color_text_heading"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_subheading"
            android:textSize="@dimen/text_size_26"
            android:textStyle="bold"
            android:textColor="@color/color_text_heading"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_tagline"
            android:textSize="@dimen/text_size_14"
            android:textColor="@color/color_text_primary"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/btn_register"
            android:textColor="@color/color_text_on_primary"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold"
            android:backgroundTint="@color/color_primary"
            app:cornerRadius="28dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/btn_login"
            android:textColor="@color/color_primary"
            android:textSize="@dimen/text_size_15"
            android:textStyle="bold"
            android:backgroundTint="@color/color_background"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/login_footer_tagline"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_size_11"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="36dp" />

    </com.mmm.bookingapp.utils.MaxWidthLinearLayout>
</ScrollView>