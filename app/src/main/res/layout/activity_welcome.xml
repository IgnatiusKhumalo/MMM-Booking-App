<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:padding="32dp">

        <!-- Logo shown edge-to-edge, no wrapper/background - the logo file
             is already a complete, fully-designed graphic (white square,
             hands-and-heart icon, full practice name), same rule already
             applied to the Home screen's branding card. -->
        <ImageView
            android:layout_width="180dp"
            android:layout_height="180dp"
            android:layout_gravity="center_horizontal"
            android:scaleType="fitCenter"
            android:src="@drawable/mmm_logo"
            android:contentDescription="@string/app_name"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_heading"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_heading"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_subheading"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/color_text_heading"
            android:layout_marginBottom="12dp"
            android:gravity="center"
            android:maxLines="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/welcome_tagline"
            android:textSize="14sp"
            android:textColor="@color/color_text_primary"
            android:layout_marginBottom="40dp"
            android:gravity="center"
            android:maxLines="2"
            android:ellipsize="end" />

        <!-- Primary and secondary actions - same rounded-pill button
             language now used consistently across Home, Login, and
             Welcome, rather than a separate default-square style here. -->
        <Button
            android:id="@+id/btnRegister"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/btn_register"
            android:textColor="@color/color_text_on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_primary"
            app:cornerRadius="28dp"
            android:layout_marginBottom="16dp" />

        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="58dp"
            android:text="@string/btn_login"
            android:textColor="@color/color_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            android:backgroundTint="@color/color_background"
            app:strokeColor="@color/color_primary"
            app:strokeWidth="1.5dp"
            app:cornerRadius="28dp"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="@string/login_footer_tagline"
            android:textColor="@color/color_text_primary"
            android:textSize="11sp"
            android:gravity="center"
            android:maxLines="1"
            android:layout_marginTop="36dp" />

    </LinearLayout>
</ScrollView>