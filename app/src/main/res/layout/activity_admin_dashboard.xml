<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarThumbVertical="@color/color_primary"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <!-- 1. Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="18dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/dashboard_header_title"
                    android:textColor="@color/color_text_heading"
                    android:textSize="20sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/admin_dashboard_subtitle"
                    android:textColor="@color/color_text_primary"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Settings: now matches Home's settings icon -->
            <ImageButton
                android:id="@+id/btnSettings"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_circle_button"
                android:padding="10dp"
                android:src="@drawable/ic_settings_sliders"
                app:tint="@color/color_text_primary"
                android:contentDescription="@string/btn_settings" />

            <!-- Logout: circular icon-only, rose/red icon -->
            <ImageButton
                android:id="@+id/btnLogoutAdmin"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_circle_button"
                android:padding="10dp"
                android:src="@drawable/ic_logout_arrow"
                app:tint="@color/color_error"
                android:contentDescription="@string/btn_logout_top" />
        </LinearLayout>

        <!-- 2. Overview card - single unified card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:padding="16dp"
            android:layout_marginBottom="18dp">

            <!-- a) 2x2 stat grid, flat left-accent style -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="8dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@color/color_status_pending" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:id="@+id/tvSummaryPending"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/color_text_heading"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_pending"
                            android:textColor="@color/color_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@color/color_status_confirmed" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:id="@+id/tvSummaryConfirmed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/color_text_heading"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_confirmed"
                            android:textColor="@color/color_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:layout_marginEnd="8dp">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@color/color_status_completed" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:id="@+id/tvSummaryCompleted"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/color_text_heading"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_completed"
                            android:textColor="@color/color_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="horizontal">

                    <View
                        android:layout_width="3dp"
                        android:layout_height="match_parent"
                        android:background="@color/color_error" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingStart="10dp">

                        <TextView
                            android:id="@+id/tvSummaryCancelled"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textColor="@color/color_text_heading"
                            android:textSize="22sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/summary_cancelled"
                            android:textColor="@color/color_text_primary"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- b) single proportional stacked bar -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <View
                    android:id="@+id/barPending"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/color_status_pending" />

                <View
                    android:id="@+id/barConfirmed"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/color_status_confirmed" />

                <View
                    android:id="@+id/barCompleted"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/color_status_completed" />

                <View
                    android:id="@+id/barCancelled"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/color_error" />

                <View
                    android:id="@+id/barEmptyFallback"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0"
                    android:background="@color/color_border" />
            </LinearLayout>

            <!-- c) legend row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/color_status_pending" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:layout_marginEnd="8dp"
                    android:text="@string/summary_pending" android:textColor="@color/color_text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/tvCountPending" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/color_text_heading" android:textSize="11sp" android:layout_marginEnd="12dp" />

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/color_status_confirmed" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:layout_marginEnd="8dp"
                    android:text="@string/summary_confirmed" android:textColor="@color/color_text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/tvCountConfirmed" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/color_text_heading" android:textSize="11sp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="16dp">

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/color_status_completed" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:layout_marginEnd="8dp"
                    android:text="@string/summary_completed" android:textColor="@color/color_text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/tvCountCompleted" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/color_text_heading" android:textSize="11sp" android:layout_marginEnd="12dp" />

                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@color/color_error" />
                <TextView
                    android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                    android:layout_marginStart="5dp" android:layout_marginEnd="8dp"
                    android:text="@string/summary_cancelled" android:textColor="@color/color_text_primary" android:textSize="11sp" />
                <TextView android:id="@+id/tvCountCancelled" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="0" android:textColor="@color/color_text_heading" android:textSize="11sp" />
            </LinearLayout>

            <!-- d) View detailed analytics -->
            <Button
                android:id="@+id/btnViewAnalytics"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:text="@string/btn_view_analytics"
                android:textColor="@color/color_primary"
                android:textSize="13sp"
                android:backgroundTint="@color/color_background"
                app:strokeColor="@color/color_primary"
                app:strokeWidth="1dp"
                app:icon="@drawable/ic_arrow_right"
                app:iconTint="@color/color_primary"
                app:iconGravity="end"
                app:iconPadding="8dp"
                style="@style/Widget.MaterialComponents.Button.OutlinedButton" />
        </LinearLayout>

        <!-- 3. Search bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_pill_outline"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:layout_marginBottom="14dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_search"
                app:tint="@color/color_text_primary" />

            <EditText
                android:id="@+id/etSearchBookings"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@android:color/transparent"
                android:hint="@string/search_hint"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/color_text_heading"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- 4. Filter pills row -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp">

                    <Spinner
                        android:id="@+id/spinnerFilterStatus"
                        android:layout_width="130dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingStart="16dp"
                        android:paddingEnd="30dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/color_text_primary" />
                </FrameLayout>

                <FrameLayout
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginEnd="8dp">

                    <Spinner
                        android:id="@+id/spinnerFilterLocation"
                        android:layout_width="140dp"
                        android:layout_height="42dp"
                        android:background="@drawable/bg_pill_dark"
                        android:paddingStart="16dp"
                        android:paddingEnd="30dp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_gravity="center_vertical|end"
                        android:layout_marginEnd="14dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/color_text_primary" />
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/tvFilterDate"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_dark"
                    android:paddingStart="16dp"
                    android:paddingEnd="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/filter_date_label"
                        android:textColor="@color/color_text_primary"
                        android:textSize="13sp" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/color_text_primary" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- 5. Utility row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="14dp">

            <TextView
                android:id="@+id/tvClearFilters"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear_filters"
                android:textColor="@color/color_text_primary"
                android:textSize="12sp" />

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_download"
                app:tint="@color/color_primary"
                android:layout_marginEnd="5dp" />

            <TextView
                android:id="@+id/tvExportCsv"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_export_csv"
                android:textColor="@color/color_primary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEmptyState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/empty_admin_bookings_message"
            android:textColor="@color/color_text_primary"
            android:textSize="14sp"
            android:gravity="center"
            android:padding="32dp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerAdminBookings"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>