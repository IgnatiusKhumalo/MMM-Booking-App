<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/color_primary"
        android:paddingStart="12dp"
        android:paddingEnd="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@android:drawable/ic_menu_revert"
            app:tint="@color/color_text_on_primary"
            android:contentDescription="@string/btn_ok" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/my_bookings_title"
            android:textColor="@color/color_text_on_primary"
            android:textSize="@dimen/text_size_18"
            android:textStyle="bold" />

        <View
            android:layout_width="40dp"
            android:layout_height="1dp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOfflineBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_status_pending"
        android:text="@string/offline_bookings_cached_message"
        android:textColor="@color/color_text_on_primary"
        android:textSize="@dimen/text_size_12"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="10dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvBookingHistorySummary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:padding="10dp"
        android:textColor="@color/color_text_heading"
        android:textSize="@dimen/text_size_12"
        android:textStyle="bold"
        android:gravity="center"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvEmptyState"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/empty_bookings_message"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_size_14"
        android:gravity="center"
        android:padding="32dp"
        android:visibility="gone" />

    <com.mmm.bookingapp.utils.MaxWidthLinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_gravity="center_horizontal"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBookings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="16dp"
            android:clipToPadding="false"
            android:scrollbars="vertical"
            android:scrollbarStyle="outsideOverlay"
            android:scrollbarThumbVertical="@color/color_primary"
            android:fadeScrollbars="false" />

    </com.mmm.bookingapp.utils.MaxWidthLinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/cancellation_policy_note"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/text_size_11"
        android:padding="14dp"
        android:gravity="center" />

</LinearLayout>