<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background"
    android:fillViewport="true"
    android:scrollbars="vertical"
    android:scrollbarStyle="outsideOverlay"
    android:scrollbarThumbVertical="@color/color_primary"
    android:fadeScrollbars="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header: pulled out as its own fixed top block, capped/centered
             for tablet width alignment but NOT part of the vertical
             centering below - matches the proven Book Appointment pattern. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="@dimen/screen_horizontal_padding">

            <ImageButton
                android:id="@+id/btnBack"
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:layout_marginEnd="14dp"
                android:background="@drawable/bg_circle_button"
                android:padding="10dp"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/color_primary"
                android:contentDescription="@string/btn_ok" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_title"
                    android:textColor="@color/color_text_heading"
                    android:textSize="@dimen/text_size_22"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/settings_subtitle"
                    android:textColor="@color/color_text_primary"
                    android:textSize="@dimen/text_size_13" />
            </LinearLayout>
        </LinearLayout>

        <!-- Centering wrapper: takes remaining space below the header,
             centers the card stack within it on tall/tablet screens. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="vertical">

            <com.mmm.bookingapp.utils.MaxWidthLinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingStart="@dimen/screen_horizontal_padding"
                android:paddingEnd="@dimen/screen_horizontal_padding"
                android:paddingBottom="@dimen/screen_horizontal_padding">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView style="@style/SectionHeader" android:text="@string/section_account" />

                    <EditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_full_name"
                        android:padding="14dp"
                        android:background="@drawable/bg_input_plain"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_plain"
                        android:padding="14dp"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_language"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:text="@string/language_value"
                            android:textColor="@color/color_text_primary" />
                    </LinearLayout>

                    <EditText
                        android:id="@+id/etPhone"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_phone"
                        android:inputType="phone"
                        android:padding="14dp"
                        android:background="@drawable/bg_input_plain"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:background="@drawable/bg_input_plain"
                        android:padding="14dp"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hint_email"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/tvEmail"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/color_text_primary" />
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnSaveChanges"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/btn_save_changes"
                        android:textColor="@color/color_text_on_primary"
                        android:backgroundTint="@color/color_primary"
                        app:cornerRadius="14dp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnDeleteAccount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_delete_account"
                        android:textColor="@color/color_error"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView style="@style/SectionHeader" android:text="@string/section_security" />

                    <Button
                        android:id="@+id/btnChangePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_change_password"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView style="@style/SectionHeader" android:text="@string/section_notifications" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_booking_reminders"
                            android:textColor="@color/color_text_primary" />

                        <Switch
                            android:id="@+id/switchNotifications"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp">

                    <TextView style="@style/SectionHeader" android:text="@string/section_app" />

                    <Button
                        android:id="@+id/btnAbout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_about"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnPrivacyPolicy"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_privacy_policy"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnTerms"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_terms"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton"
                        android:layout_marginBottom="16dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/label_dark_mode"
                            android:textColor="@color/color_text_primary" />

                        <Switch
                            android:id="@+id/switchDarkMode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/label_app_version"
                            android:textColor="@color/color_text_primary" />

                        <TextView
                            android:id="@+id/tvAppVersion"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="end"
                            android:textColor="@color/color_text_primary" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/layoutAdminSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp"
                    android:layout_marginBottom="16dp"
                    android:visibility="gone">

                    <TextView style="@style/SectionHeader" android:text="@string/section_practice_admin" />

                    <Button
                        android:id="@+id/btnPracticeInfo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_practice_info"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card"
                    android:padding="18dp">

                    <TextView style="@style/SectionHeader" android:text="@string/section_support" />

                    <Button
                        android:id="@+id/btnContactUs"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_contact_us"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnFAQ"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_faq"
                        android:textColor="@color/color_primary"
                        android:backgroundTint="@color/color_background"
                        style="@style/Widget.MMM.TallOutlinedButton"
                        android:layout_marginBottom="16dp" />

                    <Button
                        android:id="@+id/btnLogout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:singleLine="false"
                        android:text="@string/btn_logout"
                        android:textColor="@color/color_error"
                        android:backgroundTint="@color/color_background"
                        app:strokeColor="@color/color_error"
                        style="@style/Widget.MMM.TallOutlinedButton" />
                </LinearLayout>

            </com.mmm.bookingapp.utils.MaxWidthLinearLayout>
        </LinearLayout>
    </LinearLayout>
</ScrollView>